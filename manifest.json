{
  "manifest_version": 3,
  "name": "LinkedIn Helper",
  "version": "1.3.0",
  "description": "Helpers for the open LinkedIn job: driving distance and time from your UK postcode, a quick fit score, and a button that sends the job to a Claude project.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://openrouter.ai/*",
    "https://api.postcodes.io/*",
    "https://nominatim.openstreetmap.org/*",
    "https://photon.komoot.io/*",
    "https://router.project-osrm.org/*",
    "https://routing.openstreetmap.de/*",
    "https://places.googleapis.com/*",
    "https://routes.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["claude.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LinkedIn Helper",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
